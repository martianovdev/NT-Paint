# widgets/slider_bar — paint.net's option slider: [−] a light bar filled
# blue up to the value, the value written over its left, [+].  A press on
# the bar sets the value where it is and a drag follows; the buttons step
# by a hundredth of the range (one at the least).

from ui import SliderBar
from graphics import Align
from window import Button, Cursor
from view import Layout

extend SliderBar:
    dragging = false
    button = 16.0

    init(ui = &Ui, parent = &View, min = 0.0, max = 100.0, value = 0.0, suffix = "%", width = 180.0):
        self.ui = ui
        self.min = min
        self.max = max
        self.value = value
        self.suffix = suffix
        self.view = ui.create(Layout.free, parent)
        self.view.set_min_size(width, 22.0)
        self.view.set_max_size(width, 22.0)
        on self.view.draw():
            self.draw()
        on self.view.mouse_down():
            px, _ = self.view.get_pointer()
            _, _, w, _ = self.ui.rect(self.view)
            if px < self.button:
                self.step(-1.0)
            elif px >= w - self.button:
                self.step(1.0)
            else:
                self.dragging = true

    set_value(value = 0.0):
        next = clamp(value, self.min, self.max)
        if next != self.value:
            self.value = next
            self.view.render_once()

    update():
        if self.view.get_hovered():
            self.ui.want_cursor(Cursor.hand)
        if not self.dragging:
            if self.view.get_hovered():
                wheel = self.ui.wheel_steps()
                if wheel != 0:
                    self.step(float(wheel))
            return
        win = self.ui.window
        if not win.input_get_mouse_button_down(Button.left):
            self.dragging = false
            return
        px, _ = self.view.get_pointer()
        _, _, w, _ = self.ui.rect(self.view)
        bar = w - self.button * 2.0 - 4.0
        t = clamp((px - self.button - 2.0) / max(bar, 1.0), 0.0, 1.0)
        v = floor(self.min + (self.max - self.min) * t + 0.5)
        if v != self.value:
            self.set_value(v)
            emit changed(v)

    step(dir = 1.0):
        v = clamp(self.value + dir * max(1.0, floor((self.max - self.min) / 100.0)), self.min, self.max)
        if v != self.value:
            self.set_value(v)
            emit changed(v)

    draw():
        ui = self.ui
        t = ui.theme
        x, y, w, h = ui.rect(self.view)
        b = self.button
        # the buttons: a small square each with a sign
        for k in range(2):
            bx = x if k == 0 else x + w - b
            by = y + (h - 12.0) * 0.5
            ui.fill_round(bx + 1.0, by - 1.0, 14.0, 14.0, 3.0, t.button)
            ui.line(bx + 5.0, by + 6.0, bx + 11.0, by + 6.0, t.ink_soft, 1.5)
            if k == 1:
                ui.line(bx + 8.0, by + 3.0, bx + 8.0, by + 9.0, t.ink_soft, 1.5)
        bx = x + b + 2.0
        bw = w - b * 2.0 - 4.0
        ui.fill_round(bx, y + 1.0, bw, h - 2.0, t.radius, t.track)
        k = (self.value - self.min) / max(self.max - self.min, 0.0001)
        if bw * k >= 1.0:
            ui.fill_round(bx, y + 1.0, max(bw * k, t.radius * 2.0), h - 2.0, t.radius, t.accent)
        ui.text(bx + 6.0, y, bw - 10.0, h, f"{int(self.value)}{self.suffix}", t.ink, Align.left + Align.middle, t.small)
