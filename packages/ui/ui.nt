# ui — the widgets of the IDE, over the package view, drawn as natiny's
# old editor drew them: its palette and its measures (Theme), panels as
# tabs over a body on the backdrop, rows with icons.  A widget is an
# object holding its views; it hangs them under a parent view given to it
# and keeps them alive - a view nobody holds leaves the tree.  What a
# widget tells its owner it tells by events; it never knows its owner.
#
#   ui = &Ui(graphics, font, mono)
#   split = &Split(ui, ui.content, size = 280.0)
#   tree = &TreeList(ui, split.first)
#   on tree.selected(key = 0): ...
#
#   frame(dt):
#       ui.frame(dt, w, h)          # input of the frame, layout
#       split.update()              # drags, wheels: before drawing
#       graphics.window_bind(window)
#       ui.render(w, h)
#       graphics.window_unbind()
#
# Commands are what a menu, a shortcut or a button runs: one &Command per
# action, its title, its shortcut and whether it can run now; whoever
# owns the action listens to its run.
#
# Inside: core/ (the context and its drawing, icons, commands), widgets/
# (one module a widget).

package ui "0.1.0"

requires graphics "0.1"
requires view "0.1"
requires window "0.1"
requires text "0.1"

from graphics import Color, Font, Graphics
from window import Cursor, Key, Window
from view import Layout, View, Views
from text import TextEditor, TokenKind

# The palette (0xRRGGBB) and the measures of natiny's editor
Theme:
    # the window and the gaps between panels; a panel and the open tab;
    # behind code
    backdrop = 0x18181B
    chrome = 0x202024
    editor = 0x2A2A2E
    hover = 0x34343A
    # a shut tab under the pointer; a row under the pointer; the selected
    # row
    tab_hot = 0x2A2A2E
    row_hot = 0x303036
    row_on = 0x404048
    line = 0x38383E
    ink = 0xE6E6E9
    ink_muted = 0x9A9AA2
    ink_soft = 0xC6C6CB
    ink_faint = 0x64646B
    accent = 0x74747F
    accent_ink = 0xFFFFFF
    folder = 0xD8B35A
    # a Pack Folder's: violet, apart from the plain folders' gold
    pack_folder = 0xA58CF0
    file = 0x8E959E
    # each kind of file its colour, and a scene node the colour of the file
    # closest to it
    kind_scene = 0xC98AE8
    kind_material = 0xEE9460
    kind_shader = 0x4EC9B0
    kind_texture = 0x7FC86E
    kind_mesh = 0x5BAEF0
    kind_sound = 0xEE7BA6
    kind_font = 0xB8BFCC
    kind_script = 0x8C88F5
    kind_pivot = 0xE0B85C
    kind_camera = 0xEE7BA6
    kind_view = 0x7FC86E
    kind_body = 0x5CC8D8
    kind_particles = 0xF0C75E
    kind_listener = 0xEE7BA6
    kind_c = 0x5C9FE0
    kind_render = 0xE36D6D
    menu_panel = 0x242428
    field = 0x1C1C1F
    field_hot = 0x222226
    field_edge = 0x4A4A52
    button = 0x323238
    button_hot = 0x3E3E46
    error = 0xE07A6E
    warning = 0xD8B35A
    axis_x = 0xD9675F
    axis_y = 0x9CC04A
    axis_z = 0x5F93D9
    # code: selected text (the accent, far down), the caret, the line the
    # caret is on; a token by what it is
    selection = 0x4A4A56
    caret = 0xE8E8E8
    current_line = 0x252525
    code_keyword = 0xC98AE8
    code_type = 0x4EC9B0
    code_function = 0xDCDCAA
    code_number = 0xB5CEA8
    code_string = 0xCE9178
    code_comment = 0x6A9955
    code_directive = 0x6C8EBF
    code_punctuation = 0xBDBDBD
    code_property = 0x9CDCFE
    code_invalid = 0xE07A6E
    code_variable = 0x9CDCFE
    code_parameter = 0x8FB8DE
    code_method = 0xDCDCAA
    code_member = 0x4FC1FF
    code_module = 0x4EC9B0
    code_constant = 0x4FC1FF
    code_interface = 0xB8D7A3
    code_enum = 0x4EC9B0
    # the boxes over code: completion, hover, the call's parameters
    popup = 0x2A2A2F
    popup_edge = 0x45454D
    popup_on = 0x404048
    # a menu's lit row and its edge, a floating window's body and edge,
    # the close cross, a slider's track
    menu_hot = 0x38383F
    menu_edge = 0x3A3A41
    panel = 0x26262A
    panel_edge = 0x37373D
    window_inset = 2.0
    dialog_inset = 10.0
    close = 0x9A9AA2
    track = 0x37373D
    # measures
    edge = 4.0
    divider = 4.0
    radius = 4.0
    panel_pad = 6.0
    size = 13.0
    small = 12.0
    header = 26.0
    tab = 30.0
    tab_pad = 12.0
    tab_close = 16.0
    # how fast a tab moved along its strip eases into its place
    tab_slide = 18.0
    # how far a press moves before it is a drag
    drag_start = 4.0
    row = 22.0
    indent = 14.0
    row_radius = 4.0
    menu_bar = 30.0
    menu_bar_pad = 4.0
    menu_pad = 8.0
    menu_item = 24.0
    menu_separator = 9.0
    menu_min_width = 200.0
    menu_gap = 32.0
    field_height = 24.0
    button_height = 26.0
    button_width = 86.0
    gap = 8.0
    check = 16.0
    value_label = 14.0
    wheel_lines = 3.0
    code_size = 17.0
    # what Zoom In and Out keep the code's size within, a step apart
    code_min = 9.0
    code_max = 40.0
    code_step = 1.0
    # a code line's height, in code sizes
    code_line = 1.35
    gutter_pad = 12.0
    text_pad = 8.0
    caret_width = 2.0
    # seconds the caret is on, then off
    blink = 0.53

    # the code's size, held to code_min…code_max
    set_code_size(size = 0.0):
        self.code_size = min(max(size, self.code_min), self.code_max)

