# widgets/color_picker — natiny's colour panel, opened under a swatch (or
# over it when there is no room below), 240 × 276:
#
#   the square         saturation across, brightness up, at the hue
#   the hue strip      the hues left to right
#   the alpha strip    the checker into the colour
#   a swatch, the hex  #RRGGBB or #RRGGBBAA typed
#   R G B A            0…255 typed or dragged by their letters
#
# The square and the strips are drawn by the gradient shader (Ui.gradient)
# and dragged; what is dragged shows in the panel at once and is handed
# over (changed) when let go of; what is typed is handed over when kept.
# Escape, a press outside or the right button closes it.  Greys keep the
# hue and saturation they had.

from ui import ColorPicker, TextField, Ui, ValueField
from graphics import Color
from window import Button, Key
from view import Layout, View

enum Part:
    none
    square
    hue
    alpha

extend ColorPicker:
    backdrop = &View
    panel = &View
    is_open = false
    hue = 0.0
    saturation = 0.0
    value = 1.0
    alpha = 1.0
    dragging = Part.none
    hex = &TextField
    channels = [&ValueField]

    init(ui = &Ui):
        self.ui = ui
        self.backdrop = ui.create(Layout.free)
        self.backdrop.set_expand(true)
        self.panel = ui.create(Layout.free)
        self.panel.set_min_size(Box.width, Box.height)
        self.panel.set_max_size(Box.width, Box.height)
        self.hex = &TextField(ui, self.panel, "")
        Box.place(ui, self.hex.view, Box.pad + Box.swatch + 6.0, Box.fields_top(), Box.inner() - Box.swatch - 6.0, ui.theme.field_height)
        for i, letter in ["R", "G", "B", "A"].enumerate():
            f = &ValueField(ui, self.panel, letter, -1, 1.0)
            Box.place(ui, f.view, Box.pad + float(i) * (Box.cell() + 4.0), Box.fields_top() + ui.theme.field_height + 6.0, Box.cell(), ui.theme.field_height)
            on f.changed(value = 0.0):
                self.set_channel(i, value)
            on f.committed():
                self.hand_over()
            self.channels.push(f)
        on self.hex.committed(text = ""):
            if self.read_hex(text):
                self.hand_over()
            self.show_fields()
        on self.backdrop.mouse_down():
            self.close()
        on self.panel.draw():
            self.draw()

    open(x = 0.0, y = 0.0, h = 0.0, rgb = 0, alpha = 1.0):
        ui = self.ui
        _, _, lw, lh = ui.rect(ui.layer)
        top = y + h + 2.0
        if top + Box.height > lh - 4.0:
            top = y - 2.0 - Box.height
        top = clamp(top, 4.0, max(4.0, lh - Box.height - 4.0))
        left = clamp(x, 4.0, max(4.0, lw - Box.width - 4.0))
        self.panel.set_offset(left, top)
        self.hue = 0.0
        self.set_rgb(rgb, alpha)
        self.backdrop.set_parent(ui.layer)
        self.panel.set_parent(ui.layer)
        self.is_open = true

    close():
        if not self.is_open:
            return
        if self.dragging != Part.none:
            self.dragging = Part.none
            self.hand_over()
        self.panel.set_parent(none)
        self.backdrop.set_parent(none)
        self.is_open = false
        emit closed()

    get_open() -> bool:
        return self.is_open

    get_rgb() -> int:
        r, g, b = Hsv.rgb(self.hue, self.saturation, self.value)
        return (Hsv.byte(r) << 16) | (Hsv.byte(g) << 8) | Hsv.byte(b)

    get_alpha() -> float:
        return self.alpha

    update():
        if not self.is_open:
            return
        ui = self.ui
        win = ui.window
        ui.hold_keys()
        self.hex.update()
        for f in self.channels:
            f.update()
        if not self.hex.get_editing() and win.input_get_key_pressed(Key.escape):
            self.close()
            return
        if win.input_get_mouse_button_pressed(Button.right):
            self.close()
            return
        px, py = ui.pointer()
        x, y, _, _ = ui.rect(self.panel)
        if win.input_get_mouse_button_pressed(Button.left):
            self.dragging = Box.part_at(px - x, py - y)
        if self.dragging != Part.none:
            if win.input_get_mouse_button_down(Button.left):
                self.drag(px - x, py - y)
            else:
                self.dragging = Part.none
                self.hand_over()

    # ─── Inside ───

    hand_over():
        emit changed(self.get_rgb(), self.alpha)

    set_rgb(rgb = 0, alpha = 1.0):
        r = float((rgb >> 16) & 255) / 255.0
        g = float((rgb >> 8) & 255) / 255.0
        b = float(rgb & 255) / 255.0
        high = max(r, max(g, b))
        low = min(r, min(g, b))
        self.value = high
        self.alpha = clamp(alpha, 0.0, 1.0)
        # a grey or black keeps the hue and saturation it had
        if high > 0.0 and high - low > 0.0:
            self.saturation = (high - low) / high
            d = high - low
            h = 0.0
            if high == r:
                h = (g - b) / d
            elif high == g:
                h = 2.0 + (b - r) / d
            else:
                h = 4.0 + (r - g) / d
            h /= 6.0
            self.hue = h + 1.0 if h < 0.0 else h
        self.show_fields()

    set_channel(i = 0, value = 0.0):
        v = clamp(round(value), 0.0, 255.0)
        if i == 3:
            self.alpha = v / 255.0
        else:
            rgb = self.get_rgb()
            shift = 16 - i * 8
            rgb = (rgb & ~(255 << shift)) | (int(v) << shift)
            self.set_rgb(rgb, self.alpha)
        self.show_fields()

    # "#RRGGBB" or "RRGGBBAA", spaces about it: the colour taken
    read_hex(text = "") -> bool:
        t = text.strip()
        if t.starts_with("#"):
            t = t.slice(1, len(t))
        if len(t) != 6 and len(t) != 8:
            return false
        value = 0
        for c in t.lower():
            d = int(c)
            if d >= 48 and d <= 57:
                value = value * 16 + d - 48
            elif d >= 97 and d <= 102:
                value = value * 16 + d - 87
            else:
                return false
        if len(t) == 8:
            self.set_rgb(value >> 8, float(value & 255) / 255.0)
        else:
            self.set_rgb(value, 1.0)
        return true

    show_fields():
        rgb = self.get_rgb()
        if not self.hex.get_editing():
            self.hex.set_text(Hsv.hex(rgb, self.alpha))
        values = [float((rgb >> 16) & 255), float((rgb >> 8) & 255), float(rgb & 255), float(Hsv.byte(self.alpha))]
        for i, f in self.channels.enumerate():
            if not f.get_editing():
                f.set_value(values[i])

    drag(px = 0.0, py = 0.0):
        inner = Box.inner()
        across = clamp((px - Box.pad) / inner, 0.0, 1.0)
        match self.dragging:
            case Part.square:
                self.saturation = across
                self.value = 1.0 - clamp((py - Box.pad) / Box.square, 0.0, 1.0)
            case Part.hue:
                self.hue = across
            case Part.alpha:
                self.alpha = across
            case _:
                pass
        self.show_fields()

    draw():
        ui = self.ui
        t = ui.theme
        x, y, w, h = ui.rect(self.panel)
        ui.fill_round(x, y, w, h, t.radius, t.menu_panel)
        ui.outline_round(x, y, w, h, t.radius, t.field_edge)
        inner = Box.inner()
        left = x + Box.pad
        top = y + Box.pad
        rgb = self.get_rgb()
        solid = ui.color(rgb, 1.0)
        ui.gradient(0, left, top, inner, Box.square, self.hue, solid)
        sx = left + self.saturation * inner
        sy = top + (1.0 - self.value) * Box.square
        ui.graphics.render_set_color(Color(0.0, 0.0, 0.0, 0.75))
        ui.graphics.render_circle_outline(sx, sy, 6.0, 3.0)
        ui.graphics.render_set_color(Color(1.0, 1.0, 1.0, 1.0))
        ui.graphics.render_circle_outline(sx, sy, 6.0, 1.5)
        hue_top = top + Box.square + Box.pad
        ui.gradient(1, left, hue_top, inner, Box.strip, 0.0, solid)
        self.marker(left + self.hue * inner, hue_top)
        alpha_top = hue_top + Box.strip + Box.pad
        ui.gradient(2, left, alpha_top, inner, Box.strip, 0.0, solid)
        self.marker(left + self.alpha * inner, alpha_top)
        st = y + Box.fields_top()
        ui.gradient(3, left, st, Box.swatch, t.field_height, 0.0, ui.color(rgb, self.alpha))
        ui.outline(left, st, Box.swatch, t.field_height, t.line)
        self.panel.render_children()

    marker(cx = 0.0, top = 0.0):
        g = self.ui.graphics
        g.render_set_color(Color(0.0, 0.0, 0.0, 0.75))
        g.render_rounded_rectangle_outline(cx - 3.0, top - 2.0, 6.0, Box.strip + 4.0, 2.0, 2.0, 2.0, 2.0, 3.0)
        g.render_set_color(Color(1.0, 1.0, 1.0, 1.0))
        g.render_rounded_rectangle_outline(cx - 3.0, top - 2.0, 6.0, Box.strip + 4.0, 2.0, 2.0, 2.0, 2.0, 1.5)

# the panel's measures, as natiny's
Box:
    width = 240.0
    height = 276.0
    pad = 8.0
    square = 150.0
    strip = 12.0
    swatch = 40.0

    inner() -> float:
        return Box.width - 2.0 * Box.pad

    cell() -> float:
        return (Box.inner() - 12.0) / 4.0

    # the top of the swatch and the hex field
    fields_top() -> float:
        return Box.pad + Box.square + Box.pad + Box.strip + Box.pad + Box.strip + Box.pad

    place(ui = &Ui, view = &View, x = 0.0, y = 0.0, w = 0.0, h = 0.0):
        view.set_expand(false)
        view.set_min_size(w, h)
        view.set_max_size(w, h)
        view.set_offset(x, y)

    # what a press at x, y of the panel takes hold of
    part_at(x = 0.0, y = 0.0) -> Part:
        if x < Box.pad - 4.0 or x > Box.width - Box.pad + 4.0:
            return Part.none
        top = Box.pad
        if y >= top and y < top + Box.square:
            return Part.square
        top += Box.square + Box.pad
        if y >= top - 3.0 and y < top + Box.strip + 3.0:
            return Part.hue
        top += Box.strip + Box.pad
        if y >= top - 3.0 and y < top + Box.strip + 3.0:
            return Part.alpha
        return Part.none

Hsv:
    rgb(h = 0.0, s = 0.0, v = 0.0) -> (float, float, float):
        if s <= 0.0:
            return v, v, v
        hh = (h - floor(h)) * 6.0
        i = int(floor(hh))
        f = hh - float(i)
        p = v * (1.0 - s)
        q = v * (1.0 - s * f)
        t = v * (1.0 - s * (1.0 - f))
        match i % 6:
            case 0:
                return v, t, p
            case 1:
                return q, v, p
            case 2:
                return p, v, t
            case 3:
                return p, q, v
            case 4:
                return t, p, v
            case _:
                return v, p, q

    byte(x = 0.0) -> int:
        return int(clamp(round(x * 255.0), 0.0, 255.0))

    # "#RRGGBB", or "#RRGGBBAA" when not opaque
    hex(rgb = 0, alpha = 1.0) -> str:
        digits = "0123456789ABCDEF"
        out = "#"
        value = rgb
        count = 6
        if Hsv.byte(alpha) < 255:
            value = (rgb << 8) | Hsv.byte(alpha)
            count = 8
        k = count - 1
        while k >= 0:
            d = (value >> (k * 4)) & 15
            out += digits.slice(d, d + 1)
            k -= 1
        return out
