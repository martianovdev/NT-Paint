# widgets/picker — a list to pick from by typing, as natiny's editor has
# for a resource: it opens as a menu does (a backdrop that closes it on a
# press, and the panel), its first row says what was typed ("Type to
# search", "Search: ship_"), then the labels that have it in them, any
# case, 24 at most.  The first is lit, so Enter takes it; Up and Down
# move the light, Escape closes, Backspace takes a letter off.

from ui import Icon, Picker
from graphics import Align
from window import Cursor, Key
from view import Layout, View

extend Picker:
    backdrop = &View
    list = &View
    is_open = false
    labels = [str]
    icons = [Icon]
    query = ""
    # the indices of the labels shown, the one lit among them
    matches = [int]
    hot = 0
    first = 0
    rows = 1
    mouse_x = 0.0
    mouse_y = 0.0
    # where it was asked to open
    x = 0.0
    y = 0.0
    # a list to search (typing filters), or a plain one (a dropdown's);
    # the width it takes at least
    search = true
    min_width = 0.0
    # a plain list's current label: checked
    current = -1

    init(ui = &Ui):
        self.ui = ui
        self.backdrop = ui.create(Layout.free)
        self.list = ui.create(Layout.free)
        self.backdrop.set_expand(true)
        self.list.set_focusable(true)
        on self.backdrop.mouse_down():
            self.close()
        on self.list.draw():
            self.draw()
        on self.list.click():
            at = self.row_at()
            if at >= 0:
                self.choose(at)

    open(x = 0.0, y = 0.0, labels = [str], icons = [Icon]):
        self.show(x, y, labels, icons, true, 0, 0.0)

    open_list(x = 0.0, y = 0.0, labels = [str], current = 0, width = 0.0):
        self.show(x, y, labels, [Icon], false, current, width)

    show(x = 0.0, y = 0.0, labels = [str], icons = [Icon], search = true, current = 0, width = 0.0):
        self.labels = labels
        self.icons = icons
        self.query = ""
        self.x = x
        self.y = y
        self.search = search
        self.min_width = width
        self.filter()
        self.hot = clamp(current, 0, max(0, len(self.matches) - 1))
        self.reveal_hot()
        self.current = -1 if search else current
        views = self.ui.views
        self.backdrop.set_parent(self.ui.layer)
        self.list.set_parent(self.ui.layer)
        self.ui.cache(self.list)
        self.list.render_once()
        views.set_focus(self.list)
        self.is_open = true
        self.mouse_x, self.mouse_y = self.ui.pointer()

    close():
        if not self.is_open:
            return
        self.list.set_parent(none)
        self.list.set_surface(false)
        self.backdrop.set_parent(none)
        self.is_open = false
        emit closed()

    get_open() -> bool:
        return self.is_open

    update():
        if not self.is_open:
            return
        win = self.ui.window
        self.ui.hold_keys()
        if win.input_get_key_pressed(Key.escape):
            self.close()
            return
        changed = false
        before = (self.hot, self.first)
        typed = win.input_get_text() if self.search else ""
        for c in typed.chars():
            if int(c) >= 32:
                self.query = self.query + str(c)
                changed = true
        if self.search and win.input_get_key_repeated(Key.backspace) and self.query != "":
            chars = self.query.chars()
            out = ""
            for i in range(len(chars) - 1):
                out = out + str(chars[i])
            self.query = out
            changed = true
        if changed:
            self.filter()
        x, y = self.ui.pointer()
        if self.list.get_hovered():
            if self.row_at() >= 0:
                self.ui.want_cursor(Cursor.hand)
            scroll = self.ui.wheel_steps()
            if scroll != 0:
                self.first = clamp(self.first - scroll, 0, max(0, len(self.matches) - self.rows))
            if scroll != 0 or x != self.mouse_x or y != self.mouse_y:
                under = self.row_at()
                self.hot = under if under >= 0 else clamp(self.hot, self.first, max(self.first, self.first + self.rows - 1))
        self.mouse_x = x
        self.mouse_y = y
        if win.input_get_key_repeated(Key.down) and len(self.matches) > 0:
            self.hot = min(self.hot + 1, len(self.matches) - 1)
            self.reveal_hot()
        if win.input_get_key_repeated(Key.up):
            self.hot = max(self.hot - 1, 0)
            self.reveal_hot()
        if win.input_get_key_pressed(Key.enter) and len(self.matches) > 0:
            self.choose(self.hot)
        elif changed or before != (self.hot, self.first):
            self.list.render_once()

    # ─── Inside ───

    # the labels that have the query in them, the first lit; the panel
    # sized to them and kept inside the window
    filter():
        self.matches.clear()
        q = self.query.lower()
        for i, l in self.labels.enumerate():
            if q == "" or q in l.lower():
                self.matches.push(i)
                if self.search and len(self.matches) >= 24:
                    break
        self.hot = 0
        self.first = 0
        ui = self.ui
        t = ui.theme
        width = max(t.menu_min_width, self.min_width)
        for i in self.matches:
            width = max(width, 30.0 + ui.measure(self.labels[i], t.size) + 24.0)
        width = min(width, 480.0)
        _, _, lw, lh = ui.rect(ui.layer)
        capacity = max(1, int(floor((lh - 8.0 - self.head()) / t.menu_item)))
        self.rows = clamp(len(self.matches), 1, capacity)
        height = 8.0 + self.head() + float(self.rows) * t.menu_item
        left = max(0.0, min(self.x, lw - width))
        top = max(0.0, min(self.y, lh - height))
        self.list.set_min_size(width, height)
        self.list.set_max_size(width, height)
        self.list.set_offset(left, top)

    reveal_hot():
        self.first = clamp(self.first, max(0, self.hot - self.rows + 1), self.hot)

    choose(at = 0):
        index = self.matches[at]
        self.close()
        emit chosen(index)

    # the match under the pointer, -1 for none
    row_at() -> int:
        t = self.ui.theme
        px, py = self.list.get_pointer()
        _, _, w, _ = self.ui.rect(self.list)
        if px < 0.0 or px >= w:
            return -1
        top = 4.0 + self.head()
        if py < top:
            return -1
        at = int((py - top) / t.menu_item)
        if at >= self.rows or self.first + at >= len(self.matches):
            return -1
        return self.first + at

    # the height of the row saying what was typed and its line; none for a
    # plain list
    head() -> float:
        t = self.ui.theme
        return t.menu_item + t.menu_separator if self.search else 0.0

    draw():
        ui = self.ui
        t = ui.theme
        x, y, w, h = ui.rect(self.list)
        ui.fill_round(x, y, w, h, t.radius, t.menu_panel)
        size = t.size
        ry = y + 4.0
        if self.search:
            head = "Type to search" if self.query == "" else f"Search: {self.query}_"
            ui.text(x + 12.0, ry, w - 24.0, t.menu_item, head, t.ink_muted, Align.left + Align.middle, size)
            ry += t.menu_item
            ui.line(x + 10.0, ry + t.menu_separator * 0.5, x + w - 10.0, ry + t.menu_separator * 0.5, t.field_edge)
            ry += t.menu_separator
        if len(self.matches) == 0:
            ui.text(x + 12.0, ry, w - 24.0, t.menu_item, "Nothing has that in it", t.ink_faint, Align.left + Align.middle, size)
            return
        for k in range(self.first, min(self.first + self.rows, len(self.matches))):
            i = self.matches[k]
            if k == self.hot:
                ui.fill_round(x + 4.0, ry, w - 8.0, t.menu_item, t.row_radius, t.button_hot)
            left = x + 12.0
            if not self.search:
                left = x + 30.0
                if i == self.current:
                    ui.icon(Icon.check, x + 10.0, ry + (t.menu_item - 14.0) * 0.5, 14.0, t.ink)
            elif i < len(self.icons) and self.icons[i] != Icon.none:
                ui.icon(self.icons[i], x + 10.0, ry + (t.menu_item - 14.0) * 0.5, 14.0)
                left = x + 30.0
            ui.text(left, ry, w - (left - x) - 12.0, t.menu_item, self.labels[i], t.ink, Align.left + Align.middle, size)
            ry += t.menu_item
