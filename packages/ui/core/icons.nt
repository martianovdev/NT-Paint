    # The icons a scene may be shown by - in the hierarchy, the project's
    # files and over its instances in the viewport - by the names its file
    # keeps ("icon": "light"), in the order a picker lists them
    scene_icons() -> [(str, Icon)]:
        return [("light", Icon.light), ("sun", Icon.sun), ("spot", Icon.spot), ("flame", Icon.flame), ("star", Icon.star), ("heart", Icon.heart), ("coin", Icon.coin), ("key", Icon.key),
            ("flag", Icon.flag), ("pin", Icon.pin), ("door", Icon.door), ("chest", Icon.chest), ("tree", Icon.tree), ("rock", Icon.rock), ("gear", Icon.gear), ("person", Icon.person), ("enemy", Icon.enemy), ("eye", Icon.eye),
            ("cloud", Icon.cloud), ("water", Icon.water), ("bomb", Icon.bomb), ("gem", Icon.gem), ("shield", Icon.shield), ("sword", Icon.sword), ("trigger", Icon.trigger), ("target", Icon.target), ("arrow", Icon.arrow), ("music", Icon.music),
            ("camera", Icon.camera), ("sound", Icon.sound), ("particles", Icon.particles), ("listener", Icon.listener), ("view", Icon.view), ("model", Icon.model), ("body", Icon.body), ("joint", Icon.joint), ("scene", Icon.scene)]

    # the icon a scene names, Icon.scene for one it does not (or none)
    scene_icon(name = "") -> Icon:
        for n, icon in Icons.scene_icons():
            if n == name:
                return icon
        return Icon.scene
