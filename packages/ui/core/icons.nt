# core/icons — the icons of files, scene nodes and actions: natiny's
# editor's pictures as SVG on a 16-unit grid, strokes 1.5 units so an icon
# at 16 pixels has the weight of the text beside it.  Each is painted in
# currentColor, so one picture draws in any ink: graphics keeps it painted
# at the sizes and inks it is drawn in (render_svg).  Made into Svgs the
# first time one is drawn.

from ui import Icon, Ui
from graphics import Svg

extend Ui:
    icon_pictures = [&Svg]

    icon_color(icon = Icon.none) -> int:
        t = self.theme
        if icon >= Icon.tool_rect_select:
            return 0xFFFFFF
        match icon:
            case Icon.folder, Icon.folder_open:
                return t.folder
            case Icon.pack_folder, Icon.pack_folder_open:
                return t.pack_folder
            case Icon.scene:
                return t.kind_scene
            case Icon.script:
                return t.kind_script
            case Icon.material:
                return t.kind_material
            case Icon.shader:
                return t.kind_shader
            case Icon.texture:
                return t.kind_texture
            case Icon.mesh, Icon.model:
                return t.kind_mesh
            case Icon.font:
                return t.kind_font
            case Icon.sound:
                return t.kind_sound
            case Icon.c_source, Icon.c_header:
                return t.kind_c
            case Icon.render:
                return t.kind_render
            case Icon.pivot:
                return t.kind_pivot
            case Icon.camera:
                return t.kind_camera
            case Icon.view:
                return t.kind_view
            case Icon.body, Icon.joint:
                return t.kind_body
            case Icon.particles:
                return t.kind_particles
            case Icon.listener:
                return t.kind_listener
            case Icon.file, Icon.other:
                return t.file
            case _:
                return t.ink_muted

    scene_icons() -> [(str, Icon)]:
        return Icons.scene_icons()

    scene_icon(name = "") -> Icon:
        return Icons.scene_icon(name)

    icon(icon = Icon.none, x = 0.0, y = 0.0, size = 16.0, rgb = -1):
        if icon == Icon.none:
            return
        if len(self.icon_pictures) == 0:
            for body in Icons.sources():
                self.icon_pictures.push(self.graphics.svg_create(f"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'>{body}</svg>".bytes()))
        g = self.graphics
        g.render_set_color(self.color(rgb if rgb >= 0 else self.icon_color(icon)))
        g.render_svg(self.icon_pictures[int(icon) - 1], floor(x + 0.5), floor(y + 0.5), size, size)

